# =============================================================================
# azzo_agenda_pro — frontend (React + Vite)
# =============================================================================
# Copie para .env e ajuste. O .env é gitignored; ESTE arquivo é versionado —
# nunca coloque segredo real aqui.
#
# ⚠️ Tudo que começa com VITE_ é embutido no bundle e fica PÚBLICO no navegador.
#    Nunca coloque chave privada, secret ou token aqui.
# =============================================================================

# ─── API do backend (azzo-agenda-pro) ────────────────────────────────────────
# Dev: aponta direto para o backend local.
# Produção: https://app.azzoholding.com.br/agenda/api/v1
#           (a API fica atrás do prefixo /agenda no proxy; o webhook não)
VITE_API_URL=http://localhost:8080/api/v1

# ─── URLs públicas da aplicação ──────────────────────────────────────────────
# Base usada para montar os links compartilháveis de agendamento público.
# Produção: https://app.azzoholding.com.br
VITE_PUBLIC_BOOKING_BASE_URL=http://localhost:5173

# Fallback de URL pública, lido por src/lib/public-booking-url.ts e
# src/pages/SalePage.tsx. O nome tem prefixo NEXT_ por herança de uma versão
# Next.js do projeto — continua em uso, não remova.
NEXT_PUBLIC_APP_URL=https://www.azzoholding.com.br

# ─── Meta / WhatsApp Embedded Signup ─────────────────────────────────────────
# Só é necessário quando o backend está com WHATSAPP_EMBEDDED_SIGNUP_ENABLED=true.
# Sem os três valores a aba "Meta" aparece desabilitada, com aviso na tela —
# o onboarding manual da Cloud API continua funcionando normalmente.
# Não são segredos: o App ID e o Config ID são públicos por natureza.
VITE_META_APP_ID=__set_in_prod__
VITE_META_CONFIG_ID=__set_in_prod__
VITE_META_EMBEDDED_REDIRECT_URI=https://app.azzoholding.com.br/agenda/api/v1/public/meta/oauth/callback
